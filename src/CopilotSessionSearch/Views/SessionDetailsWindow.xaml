<Window x:Class="CopilotSessionSearch.Views.SessionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CopilotSessionSearch.Controls"
        Height="780"
        Icon="../Assets/CopilotSessionSearch.ico"
        MinHeight="520"
        MinWidth="760"
        PreviewKeyDown="SessionDetailsWindow_PreviewKeyDown"
        PreviewMouseDown="SessionDetailsWindow_PreviewMouseDown"
        Title="{Binding Name, StringFormat=Session - {0}}"
        Width="1080"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <DataTemplate x:Key="DetailMessageTemplate">
      <Grid>
        <Grid.Style>
          <Style TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="4" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding DataContext.IsShowingWholeConversation, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Value="True">
                <Setter Property="Margin" Value="0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontWeight="SemiBold">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsShowingWholeConversation, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Run Text="{Binding SpeakerText, Mode=OneTime}" />
          <Run Text=" - " />
          <Run Text="{Binding TimestampText, Mode=OneTime}" />
          <Run Text=" - " />
          <Run Text="{Binding MessageText, Mode=OneTime}" />
          <Run Text=" - " />
          <Run Text="{Binding OccurrenceText, Mode=OneTime}" />
        </TextBlock>

        <TextBlock Grid.Row="0"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   FontSize="11"
                   FontWeight="Normal"
                   Text="{Binding SpeakerText, Mode=OneTime}">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsShowingWholeConversation, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="1"
                   FontStyle="Italic"
                   Margin="0,3,0,0"
                   Text="{Binding AiReason, Mode=OneTime}"
                   TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasAiReason, Mode=OneTime}" Value="True" />
                    <Condition Binding="{Binding DataContext.IsShowingWholeConversation, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="2">
          <Border.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Margin" Value="0,8,0,0" />
              <Setter Property="Padding" Value="8" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsShowingWholeConversation, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True">
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Margin" Value="0,2,0,0" />
                  <Setter Property="Padding" Value="0" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <controls:SelectableMarkdownViewer AutomationProperties.Name="Rendered conversation message"
                                             Background="Transparent"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                             HighlightText="{Binding HighlightText, Mode=OneTime}"
                                             HorizontalScrollBarVisibility="Auto"
                                             IsCaseSensitive="{Binding IsCaseSensitive, Mode=OneTime}"
                                             IsSelectionEnabled="True"
                                             IsTabStop="False"
                                             IsToolBarVisible="False"
                                             MatchWholeWord="{Binding MatchWholeWord, Mode=OneTime}"
                                             MaxHeight="620"
                                             SourceMarkdown="{Binding MarkdownText, Mode=OneTime}"
                                             UseRegularExpression="{Binding UseRegularExpression, Mode=OneTime}"
                                             VerticalScrollBarVisibility="Auto">
            <controls:SelectableMarkdownViewer.Style>
              <Style TargetType="{x:Type controls:SelectableMarkdownViewer}">
                <Setter Property="MinHeight" Value="72" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DataContext.IsShowingWholeConversation, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Value="True">
                    <Setter Property="MinHeight" Value="0" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:SelectableMarkdownViewer.Style>
          </controls:SelectableMarkdownViewer>
        </Border>
      </Grid>
    </DataTemplate>

    <Style x:Key="DetailItemStyle" TargetType="{x:Type ListViewItem}">
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, Mode=OneTime}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="8" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding DataContext.IsShowingWholeConversation, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                     Value="True">
          <Setter Property="Margin" Value="0,0,0,2" />
          <Setter Property="Padding" Value="4,2" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MetadataValueStyle" TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="IsReadOnlyCaretVisible" Value="True" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="MetadataCopyButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.AccentColorLight1BrushKey}}" />
      <Setter Property="Height" Value="24" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid>
              <Border x:Name="HoverSurface"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="2"
                      Opacity="0" />
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverSurface" Property="Opacity" Value="0.12" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HoverSurface" Property="Opacity" Value="0.22" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type DockPanel}}}"
                     Value="True">
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="16,16,16,8">
      <Grid.LayoutTransform>
        <ScaleTransform ScaleX="{Binding Zoom.Scale}" ScaleY="{Binding Zoom.Scale}" />
      </Grid.LayoutTransform>

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
              BorderThickness="1"
              Padding="4,2">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="1"
                  AutomationProperties.HelpText="Show or hide session information"
                  AutomationProperties.Name="{Binding SessionInfoButtonText}"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0"
                  Command="{Binding ToggleSessionInfoCommand}"
                  Margin="6,0,0,0"
                  MinHeight="24"
                  MinWidth="24"
                  Padding="4"
                  ToolTip="{Binding SessionInfoButtonText}">
            <TextBlock FontFamily="Segoe Fluent Icons"
                       FontSize="12"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Text" Value="&#xE70D;" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSessionInfoExpanded}" Value="True">
                      <Setter Property="Text" Value="&#xE70E;" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Button>

          <TextBox AutomationProperties.Name="Session name"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Style="{StaticResource MetadataValueStyle}"
                   Text="{Binding Name, Mode=OneTime}" />

          <Grid Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,4,0,0"
                Visibility="{Binding IsSessionInfoExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SessionIdLabel"
                       FontWeight="SemiBold"
                       Margin="0,0,12,0"
                       Text="Session ID:" />
            <DockPanel Grid.Column="1"
                       Background="Transparent"
                       HorizontalAlignment="Left"
                       LastChildFill="False">
              <TextBox DockPanel.Dock="Left"
                       AutomationProperties.LabeledBy="{Binding ElementName=SessionIdLabel}"
                       Style="{StaticResource MetadataValueStyle}"
                       Text="{Binding SessionId, Mode=OneTime}" />
              <Button DockPanel.Dock="Left"
                      AutomationProperties.Name="Copy session ID"
                      Command="{Binding CopySessionIdCommand}"
                      Margin="4,0,0,0"
                      Style="{StaticResource MetadataCopyButtonStyle}"
                      ToolTip="Copy session ID">
                <TextBlock FontFamily="Segoe Fluent Icons"
                           FontSize="12"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           IsHitTestVisible="False"
                           Text="&#xE8C8;" />
              </Button>
            </DockPanel>

            <TextBlock x:Name="WorkingDirectoryLabel"
                       Grid.Row="1"
                       FontWeight="SemiBold"
                       Margin="0,4,12,0"
                       Text="Working directory:" />
            <DockPanel Grid.Row="1"
                       Grid.Column="1"
                       Background="Transparent"
                       HorizontalAlignment="Left"
                       LastChildFill="False"
                       Margin="0,4,0,0">
              <TextBox DockPanel.Dock="Left"
                       AutomationProperties.LabeledBy="{Binding ElementName=WorkingDirectoryLabel}"
                       Style="{StaticResource MetadataValueStyle}"
                       Text="{Binding WorkingDirectory, Mode=OneTime}" />
              <Button DockPanel.Dock="Left"
                      AutomationProperties.Name="Copy working directory"
                      Command="{Binding CopyWorkingDirectoryCommand}"
                      Margin="4,0,0,0"
                      Style="{StaticResource MetadataCopyButtonStyle}"
                      ToolTip="Copy working directory">
                <TextBlock FontFamily="Segoe Fluent Icons"
                           FontSize="12"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           IsHitTestVisible="False"
                           Text="&#xE8C8;" />
              </Button>
            </DockPanel>

            <TextBlock x:Name="RepositoryLabel"
                       Grid.Row="2"
                       FontWeight="SemiBold"
                       Margin="0,4,12,0"
                       Text="Repository:" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     AutomationProperties.LabeledBy="{Binding ElementName=RepositoryLabel}"
                     Margin="0,4,0,0"
                     Style="{StaticResource MetadataValueStyle}"
                     Text="{Binding RepositoryAndBranch, Mode=OneTime}" />

            <TextBlock x:Name="StartedLabel"
                       Grid.Row="3"
                       FontWeight="SemiBold"
                       Margin="0,4,12,0"
                       Text="Started:" />
            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     AutomationProperties.LabeledBy="{Binding ElementName=StartedLabel}"
                     Margin="0,4,0,0"
                     Style="{StaticResource MetadataValueStyle}"
                     Text="{Binding StartTimeText, Mode=OneTime}" />

            <TextBlock x:Name="LastActiveLabel"
                       Grid.Row="4"
                       FontWeight="SemiBold"
                       Margin="0,4,12,0"
                       Text="Last active:" />
            <TextBox Grid.Row="4"
                     Grid.Column="1"
                     AutomationProperties.LabeledBy="{Binding ElementName=LastActiveLabel}"
                     Margin="0,4,0,0"
                     Style="{StaticResource MetadataValueStyle}"
                     Text="{Binding LastActiveText, Mode=OneTime}" />

            <TextBlock x:Name="SessionSpanLabel"
                       Grid.Row="5"
                       FontWeight="SemiBold"
                       Margin="0,4,12,0"
                       Text="Session span:" />
            <TextBox Grid.Row="5"
                     Grid.Column="1"
                     AutomationProperties.LabeledBy="{Binding ElementName=SessionSpanLabel}"
                     Margin="0,4,0,0"
                     Style="{StaticResource MetadataValueStyle}"
                     Text="{Binding SessionSpanSummaryText, Mode=OneTime}" />

            <TextBlock x:Name="SearchLabel"
                       Grid.Row="6"
                       FontWeight="SemiBold"
                       Margin="0,4,12,0"
                       Text="Search:" />
            <TextBox Grid.Row="6"
                     Grid.Column="1"
                     AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}"
                     Margin="0,4,0,0"
                     Style="{StaticResource MetadataValueStyle}"
                     Text="{Binding SearchSummaryText, Mode=OneTime}" />

            <TextBlock x:Name="ResumeCommandLabel"
                       Grid.Row="7"
                       FontWeight="SemiBold"
                       Margin="0,4,12,0"
                       Text="Resume command:" />
            <DockPanel Grid.Row="7"
                       Grid.Column="1"
                       Background="Transparent"
                       HorizontalAlignment="Left"
                       LastChildFill="False"
                       Margin="0,4,0,0">
              <TextBox DockPanel.Dock="Left"
                       AutomationProperties.LabeledBy="{Binding ElementName=ResumeCommandLabel}"
                       FontFamily="Consolas"
                       Style="{StaticResource MetadataValueStyle}"
                       Text="{Binding ResumeCommandText, Mode=OneTime}" />
              <Button DockPanel.Dock="Left"
                      AutomationProperties.Name="Copy resume command"
                      Command="{Binding CopyResumeCommand}"
                      Margin="4,0,0,0"
                      Style="{StaticResource MetadataCopyButtonStyle}"
                      ToolTip="Copy resume command">
                <TextBlock FontFamily="Segoe Fluent Icons"
                           FontSize="12"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           IsHitTestVisible="False"
                           Text="&#xE8C8;" />
              </Button>
            </DockPanel>
          </Grid>
        </Grid>
      </Border>

      <ListView x:Name="MessagesListView"
                Grid.Row="1"
                AutomationProperties.Name="Conversation messages"
                ItemContainerStyle="{StaticResource DetailItemStyle}"
                ItemTemplate="{StaticResource DetailMessageTemplate}"
                ItemsSource="{Binding Messages}"
                KeyboardNavigation.TabNavigation="Once"
                Margin="0,12,0,0"
                PreviewKeyDown="MessagesListView_PreviewKeyDown"
                PreviewMouseLeftButtonDown="MessagesListView_PreviewMouseLeftButtonDown"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                SelectedItem="{Binding SelectedMessage}"
                SelectionMode="Single"
                TabIndex="0"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling" />

      <TextBlock Grid.Row="2"
                 AutomationProperties.LiveSetting="Assertive"
                 FontWeight="SemiBold"
                 Margin="0,8,0,0"
                 Text="{Binding ErrorMessage}">
        <TextBlock.Style>
          <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <StackPanel Grid.Row="3"
                  HorizontalAlignment="Right"
                  Margin="0,12,0,0"
                  Orientation="Horizontal">
        <Button Command="{Binding CopySessionInfoCommand}"
                Content="Copy session _info"
                MinWidth="132"
                TabIndex="1"
                ToolTip="Copy session metadata and resume command (Alt+I)" />
        <Button Click="CopyWholeMessageButton_Click"
                Content="_Copy whole message"
                Margin="8,0,0,0"
                MinWidth="160"
                TabIndex="2"
                ToolTip="Copy the selected whole message with rich formatting and Markdown text (Alt+C)" />
        <Button Command="{Binding ResumeCommand}"
                Content="_Resume in console"
                Margin="8,0,0,0"
                MinWidth="132"
                TabIndex="3"
                ToolTip="Resume this session (Alt+R)" />
        <Button Click="CloseButton_Click"
                Content="Cl_ose"
                Margin="8,0,0,0"
                MinWidth="88"
                TabIndex="4"
                ToolTip="Close this window (Alt+O)" />
      </StackPanel>
    </Grid>

    <StatusBar Grid.Row="1"
               Height="24"
               Padding="0">
      <StatusBarItem HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     Padding="8,0"
                     VerticalContentAlignment="Center">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock AutomationProperties.LiveSetting="Polite"
                     FontSize="12"
                     Text="{Binding StatusBarText}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />

          <controls:ZoomStatusControl Grid.Column="1"
                                      DataContext="{Binding Zoom}"
                                      Margin="8,0,0,0"
                                      TabIndex="5" />

          <Button Grid.Column="2"
                  AutomationProperties.HelpText="Switch between matching messages and the whole conversation"
                  AutomationProperties.Name="{Binding MessageViewButtonText}"
                  Command="{Binding ToggleMessageViewCommand}"
                  Margin="8,0,0,0"
                  MinHeight="24"
                  MinWidth="26"
                  Padding="4,1"
                  TabIndex="6"
                  ToolTip="{Binding MessageViewButtonText}">
            <controls:ConversationViewGlyph Height="14"
                                            IsHitTestVisible="False"
                                            IsWholeConversation="{Binding IsShowingWholeConversation}"
                                            Width="14" />
          </Button>
        </Grid>
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
