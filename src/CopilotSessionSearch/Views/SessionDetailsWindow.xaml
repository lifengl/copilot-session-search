<Window x:Class="CopilotSessionSearch.Views.SessionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CopilotSessionSearch.Controls"
        Height="780"
        Icon="../Assets/CopilotSessionSearch.ico"
        MinHeight="520"
        MinWidth="760"
        Title="{Binding Name, StringFormat=Session details - {0}}"
        Width="1080"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <DataTemplate x:Key="DetailMessageTemplate">
      <Grid Margin="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontWeight="SemiBold">
          <Run Text="{Binding SpeakerText, Mode=OneTime}" />
          <Run Text=" - " />
          <Run Text="{Binding TimestampText, Mode=OneTime}" />
          <Run Text=" - " />
          <Run Text="{Binding MessageText, Mode=OneTime}" />
          <Run Text=" - " />
          <Run Text="{Binding OccurrenceText, Mode=OneTime}" />
        </TextBlock>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                Margin="0,8,0,0"
                Padding="8">
          <controls:SelectableMarkdownViewer AutomationProperties.Name="Rendered conversation message"
                                             Background="Transparent"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                             HighlightText="{Binding Query, Mode=OneTime}"
                                             HorizontalScrollBarVisibility="Auto"
                                             IsSelectionEnabled="True"
                                             IsTabStop="False"
                                             IsToolBarVisible="False"
                                             MaxHeight="620"
                                             MinHeight="72"
                                             SourceMarkdown="{Binding MarkdownText, Mode=OneTime}"
                                             VerticalScrollBarVisibility="Auto" />
        </Border>
      </Grid>
    </DataTemplate>

    <Style x:Key="DetailItemStyle" TargetType="{x:Type ListViewItem}">
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, Mode=OneTime}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="8" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1"
            Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="{Binding Name, Mode=OneTime}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1"
                   FontWeight="SemiBold"
                   Margin="0,8,12,0"
                   Text="Session ID:" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,8,0,0"
                   Text="{Binding SessionId, Mode=OneTime}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="2"
                   FontWeight="SemiBold"
                   Margin="0,4,12,0"
                   Text="Working directory:" />
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Margin="0,4,0,0"
                   Text="{Binding WorkingDirectory, Mode=OneTime}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="3"
                   FontWeight="SemiBold"
                   Margin="0,4,12,0"
                   Text="Repository:" />
        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   Margin="0,4,0,0"
                   Text="{Binding RepositoryAndBranch, Mode=OneTime}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="4"
                   FontWeight="SemiBold"
                   Margin="0,4,12,0"
                   Text="Started:" />
        <TextBlock Grid.Row="4"
                   Grid.Column="1"
                   Margin="0,4,0,0"
                   Text="{Binding StartTimeText, Mode=OneTime}" />

        <TextBlock Grid.Row="5"
                   FontWeight="SemiBold"
                   Margin="0,4,12,0"
                   Text="Last active:" />
        <TextBlock Grid.Row="5"
                   Grid.Column="1"
                   Margin="0,4,0,0"
                   Text="{Binding LastActiveText, Mode=OneTime}" />

        <TextBlock Grid.Row="6"
                   FontWeight="SemiBold"
                   Margin="0,4,12,0"
                   Text="Session span:" />
        <TextBlock Grid.Row="6"
                   Grid.Column="1"
                   Margin="0,4,0,0">
          <Run Text="{Binding SessionSpanText, Mode=OneTime}" />
          <Run Text=" - " />
          <Run Text="{Binding MessageCountText, Mode=OneTime}" />
        </TextBlock>

        <TextBlock Grid.Row="7"
                   FontWeight="SemiBold"
                   Margin="0,4,12,0"
                   Text="Search:" />
        <TextBlock Grid.Row="7"
                   Grid.Column="1"
                   Margin="0,4,0,0">
          <Run Text="{Binding Query, Mode=OneTime}" />
          <Run Text=" - " />
          <Run Text="{Binding MatchCountText, Mode=OneTime}" />
        </TextBlock>

        <TextBlock Grid.Row="8"
                   Grid.ColumnSpan="2"
                   Margin="0,8,0,0"
                   Text="Use arrow or paging keys to navigate messages. Press Enter to focus rendered text, then Escape to return to the list. The mouse wheel moves between messages; use a message's scrollbar for long content."
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <ListView x:Name="MessagesListView"
              Grid.Row="1"
              AutomationProperties.Name="Matching conversation messages"
              ItemContainerStyle="{StaticResource DetailItemStyle}"
              ItemTemplate="{StaticResource DetailMessageTemplate}"
              ItemsSource="{Binding Messages}"
              KeyboardNavigation.TabNavigation="Once"
              Margin="0,12,0,0"
              PreviewKeyDown="MessagesListView_PreviewKeyDown"
              PreviewMouseLeftButtonDown="MessagesListView_PreviewMouseLeftButtonDown"
              ScrollViewer.CanContentScroll="True"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              SelectedItem="{Binding SelectedMessage}"
              SelectionMode="Single"
              TabIndex="0"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling" />

    <StackPanel Grid.Row="2" Margin="0,8,0,0">
      <TextBlock AutomationProperties.LiveSetting="Polite"
                 Text="{Binding StatusMessage}">
        <TextBlock.Style>
          <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock AutomationProperties.LiveSetting="Assertive"
                 FontWeight="SemiBold"
                 Text="{Binding ErrorMessage}">
        <TextBlock.Style>
          <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>

    <StackPanel Grid.Row="3"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Orientation="Horizontal">
      <Button Command="{Binding CopySelectedMessageCommand}"
              Content="_Copy selected message"
              MinWidth="160"
              TabIndex="1"
              ToolTip="Copy the selected full message (Ctrl+C or Alt+C)" />
      <Button Command="{Binding ResumeCommand}"
              Content="_Resume in console"
              Margin="8,0,0,0"
              MinWidth="132"
              TabIndex="2"
              ToolTip="Resume this session (Alt+R)" />
      <Button Click="CloseButton_Click"
              Content="Cl_ose"
              Margin="8,0,0,0"
              MinWidth="88"
              TabIndex="3"
              ToolTip="Close this window (Alt+O)" />
    </StackPanel>
  </Grid>
</Window>
