<Window x:Class="CopilotSessionSearch.Views.SessionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CopilotSessionSearch.Controls"
        Height="780"
        Icon="../Assets/CopilotSessionSearch.ico"
        MinHeight="520"
        MinWidth="760"
        PreviewKeyDown="SessionDetailsWindow_PreviewKeyDown"
        Title="{Binding Name, StringFormat=Session details - {0}}"
        Width="1080"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <DataTemplate x:Key="DetailMessageTemplate">
      <Grid Margin="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontWeight="SemiBold">
          <Run Text="{Binding SpeakerText, Mode=OneTime}" />
          <Run Text=" - " />
          <Run Text="{Binding TimestampText, Mode=OneTime}" />
          <Run Text=" - " />
          <Run Text="{Binding MessageText, Mode=OneTime}" />
          <Run Text=" - " />
          <Run Text="{Binding OccurrenceText, Mode=OneTime}" />
        </TextBlock>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                Margin="0,8,0,0"
                Padding="8">
          <controls:SelectableMarkdownViewer AutomationProperties.Name="Rendered conversation message"
                                             Background="Transparent"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                             HighlightText="{Binding Query, Mode=OneTime}"
                                             HorizontalScrollBarVisibility="Auto"
                                             IsCaseSensitive="{Binding IsCaseSensitive, Mode=OneTime}"
                                             IsSelectionEnabled="True"
                                             IsTabStop="False"
                                             IsToolBarVisible="False"
                                             MatchWholeWord="{Binding MatchWholeWord, Mode=OneTime}"
                                             MaxHeight="620"
                                             MinHeight="72"
                                             SourceMarkdown="{Binding MarkdownText, Mode=OneTime}"
                                             UseRegularExpression="{Binding UseRegularExpression, Mode=OneTime}"
                                             VerticalScrollBarVisibility="Auto" />
        </Border>
      </Grid>
    </DataTemplate>

    <Style x:Key="DetailItemStyle" TargetType="{x:Type ListViewItem}">
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName, Mode=OneTime}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="MetadataValueStyle" TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="IsReadOnlyCaretVisible" Value="True" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="16,16,16,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
              BorderThickness="1"
              Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.ColumnSpan="2"
                   AutomationProperties.Name="Session name"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Style="{StaticResource MetadataValueStyle}"
                   Text="{Binding Name, Mode=OneTime}" />

          <TextBlock x:Name="SessionIdLabel"
                     Grid.Row="1"
                     FontWeight="SemiBold"
                     Margin="0,8,12,0"
                     Text="Session ID:" />
          <TextBox Grid.Row="1"
                   Grid.Column="1"
                   AutomationProperties.LabeledBy="{Binding ElementName=SessionIdLabel}"
                   Margin="0,8,0,0"
                   Style="{StaticResource MetadataValueStyle}"
                   Text="{Binding SessionId, Mode=OneTime}" />

          <TextBlock x:Name="WorkingDirectoryLabel"
                     Grid.Row="2"
                     FontWeight="SemiBold"
                     Margin="0,4,12,0"
                     Text="Working directory:" />
          <TextBox Grid.Row="2"
                   Grid.Column="1"
                   AutomationProperties.LabeledBy="{Binding ElementName=WorkingDirectoryLabel}"
                   Margin="0,4,0,0"
                   Style="{StaticResource MetadataValueStyle}"
                   Text="{Binding WorkingDirectory, Mode=OneTime}" />

          <TextBlock x:Name="RepositoryLabel"
                     Grid.Row="3"
                     FontWeight="SemiBold"
                     Margin="0,4,12,0"
                     Text="Repository:" />
          <TextBox Grid.Row="3"
                   Grid.Column="1"
                   AutomationProperties.LabeledBy="{Binding ElementName=RepositoryLabel}"
                   Margin="0,4,0,0"
                   Style="{StaticResource MetadataValueStyle}"
                   Text="{Binding RepositoryAndBranch, Mode=OneTime}" />

          <TextBlock x:Name="StartedLabel"
                     Grid.Row="4"
                     FontWeight="SemiBold"
                     Margin="0,4,12,0"
                     Text="Started:" />
          <TextBox Grid.Row="4"
                   Grid.Column="1"
                   AutomationProperties.LabeledBy="{Binding ElementName=StartedLabel}"
                   Margin="0,4,0,0"
                   Style="{StaticResource MetadataValueStyle}"
                   Text="{Binding StartTimeText, Mode=OneTime}" />

          <TextBlock x:Name="LastActiveLabel"
                     Grid.Row="5"
                     FontWeight="SemiBold"
                     Margin="0,4,12,0"
                     Text="Last active:" />
          <TextBox Grid.Row="5"
                   Grid.Column="1"
                   AutomationProperties.LabeledBy="{Binding ElementName=LastActiveLabel}"
                   Margin="0,4,0,0"
                   Style="{StaticResource MetadataValueStyle}"
                   Text="{Binding LastActiveText, Mode=OneTime}" />

          <TextBlock x:Name="SessionSpanLabel"
                     Grid.Row="6"
                     FontWeight="SemiBold"
                     Margin="0,4,12,0"
                     Text="Session span:" />
          <TextBox Grid.Row="6"
                   Grid.Column="1"
                   AutomationProperties.LabeledBy="{Binding ElementName=SessionSpanLabel}"
                   Margin="0,4,0,0"
                   Style="{StaticResource MetadataValueStyle}"
                   Text="{Binding SessionSpanSummaryText, Mode=OneTime}" />

          <TextBlock x:Name="SearchLabel"
                     Grid.Row="7"
                     FontWeight="SemiBold"
                     Margin="0,4,12,0"
                     Text="Search:" />
          <TextBox Grid.Row="7"
                   Grid.Column="1"
                   AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}"
                   Margin="0,4,0,0"
                   Style="{StaticResource MetadataValueStyle}"
                   Text="{Binding SearchSummaryText, Mode=OneTime}" />

          <TextBlock x:Name="ResumeCommandLabel"
                     Grid.Row="8"
                     FontWeight="SemiBold"
                     Margin="0,4,12,0"
                     Text="Resume command:" />
          <TextBox Grid.Row="8"
                   Grid.Column="1"
                   AutomationProperties.LabeledBy="{Binding ElementName=ResumeCommandLabel}"
                   FontFamily="Consolas"
                   Margin="0,4,0,0"
                   Style="{StaticResource MetadataValueStyle}"
                   Text="{Binding ResumeCommandText, Mode=OneTime}" />
        </Grid>
      </Border>

      <ListView x:Name="MessagesListView"
                Grid.Row="1"
                AutomationProperties.Name="Matching conversation messages"
                ItemContainerStyle="{StaticResource DetailItemStyle}"
                ItemTemplate="{StaticResource DetailMessageTemplate}"
                ItemsSource="{Binding Messages}"
                KeyboardNavigation.TabNavigation="Once"
                Margin="0,12,0,0"
                PreviewKeyDown="MessagesListView_PreviewKeyDown"
                PreviewMouseLeftButtonDown="MessagesListView_PreviewMouseLeftButtonDown"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                SelectedItem="{Binding SelectedMessage}"
                SelectionMode="Single"
                TabIndex="0"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling" />

      <TextBlock Grid.Row="2"
                 AutomationProperties.LiveSetting="Assertive"
                 FontWeight="SemiBold"
                 Margin="0,8,0,0"
                 Text="{Binding ErrorMessage}">
        <TextBlock.Style>
          <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <StackPanel Grid.Row="3"
                  HorizontalAlignment="Right"
                  Margin="0,12,0,0"
                  Orientation="Horizontal">
        <Button Command="{Binding CopySessionInfoCommand}"
                Content="Copy session _info"
                MinWidth="132"
                TabIndex="1"
                ToolTip="Copy session metadata and resume command (Alt+I)" />
        <Button Click="CopyWholeMessageButton_Click"
                Content="_Copy whole message"
                Margin="8,0,0,0"
                MinWidth="160"
                TabIndex="2"
                ToolTip="Copy the selected whole message with rich formatting and Markdown text (Alt+C)" />
        <Button Command="{Binding ResumeCommand}"
                Content="_Resume in console"
                Margin="8,0,0,0"
                MinWidth="132"
                TabIndex="3"
                ToolTip="Resume this session (Alt+R)" />
        <Button Click="CloseButton_Click"
                Content="Cl_ose"
                Margin="8,0,0,0"
                MinWidth="88"
                TabIndex="4"
                ToolTip="Close this window (Alt+O)" />
      </StackPanel>
    </Grid>

    <StatusBar Grid.Row="1"
               Height="24"
               Padding="0">
      <StatusBarItem HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     Padding="8,0"
                     VerticalContentAlignment="Center">
        <TextBlock AutomationProperties.LiveSetting="Polite"
                   FontSize="12"
                   Text="{Binding StatusBarText}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
