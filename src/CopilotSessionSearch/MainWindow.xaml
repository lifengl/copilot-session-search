<Window x:Class="CopilotSessionSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CopilotSessionSearch.Controls"
        Height="720"
        Icon="Assets/CopilotSessionSearch.ico"
        MinHeight="480"
        MinWidth="720"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        Title="Copilot Session Search"
        Width="1040"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="AiSearchGlyphBrush" Color="#CA5010" />
    <SolidColorBrush x:Key="CaseSensitiveGlyphBrush" Color="#008272" />
    <SolidColorBrush x:Key="RegularExpressionGlyphBrush" Color="#8764B8" />
    <SolidColorBrush x:Key="StopGlyphBrush" Color="#D13438" />
    <SolidColorBrush x:Key="WholeWordGlyphBrush" Color="#0078D4" />

    <DataTemplate x:Key="SampleTemplate">
      <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
              BorderThickness="1"
              Margin="0,6,0,0"
              Padding="8">
        <StackPanel>
          <TextBlock FontWeight="SemiBold">
            <Run Text="{Binding SpeakerText, Mode=OneTime}" />
            <Run Text=" - " />
            <Run Text="{Binding TimestampText, Mode=OneTime}" />
            <Run Text="{Binding AiScoreText, Mode=OneTime}" />
          </TextBlock>
          <controls:HighlightedTextBlock HighlightText="{Binding HighlightText, Mode=OneTime}"
                                         IsCaseSensitive="{Binding IsCaseSensitive, Mode=OneTime}"
                                         Margin="0,3,0,0"
                                         MatchWholeWord="{Binding MatchWholeWord, Mode=OneTime}"
                                         MaxHeight="44"
                                         SourceText="{Binding PreviewText, Mode=OneTime}"
                                         TextTrimming="CharacterEllipsis"
                                         TextWrapping="Wrap"
                                         UseRegularExpression="{Binding UseRegularExpression, Mode=OneTime}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="SearchResultTemplate">
      <Border Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock FontSize="15"
                     FontWeight="SemiBold"
                     Text="{Binding Name, Mode=OneTime}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Name, Mode=OneTime}" />
          <TextBlock Grid.Column="1"
                     Margin="12,0,0,0"
                     Text="{Binding MatchCountText, Mode=OneTime}" />
          <TextBlock Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Margin="0,3,0,0"
                     Text="{Binding LastActiveText, Mode=OneTime}" />
          <TextBlock Grid.Row="2"
                     Grid.ColumnSpan="2"
                     Margin="0,3,0,0"
                     Text="{Binding WorkingDirectory, Mode=OneTime}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding WorkingDirectory, Mode=OneTime}" />
          <TextBlock Grid.Row="3"
                     Grid.ColumnSpan="2"
                     FontStyle="Italic"
                     Margin="0,3,0,0"
                     Text="{Binding AiReason, Mode=OneTime}"
                     TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasAiReason, Mode=OneTime}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl Grid.Row="4"
                        Grid.ColumnSpan="2"
                        ItemTemplate="{StaticResource SampleTemplate}"
                        ItemsSource="{Binding Samples, Mode=OneTime}" />
        </Grid>
      </Border>
    </DataTemplate>

    <Style x:Key="SearchResultItemStyle" TargetType="{x:Type ListViewItem}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneTime}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="0" />
      <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SearchResultItem_PreviewMouseLeftButtonUp" />
    </Style>

    <Style x:Key="IconTextButtonContentStyle" TargetType="{x:Type StackPanel}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                     Value="False">
          <Setter Property="Opacity" Value="0.45" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SearchOptionGlyphStyle" TargetType="{x:Type controls:SearchOptionGlyph}">
      <Setter Property="Height" Value="16" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Width" Value="18" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        </DataTrigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AiSearchOptionGlyphStyle"
           BasedOn="{StaticResource SearchOptionGlyphStyle}"
           TargetType="{x:Type controls:SearchOptionGlyph}">
      <Setter Property="Foreground" Value="{StaticResource AiSearchGlyphBrush}" />
    </Style>

    <Style x:Key="CaseSensitiveOptionGlyphStyle"
           BasedOn="{StaticResource SearchOptionGlyphStyle}"
           TargetType="{x:Type controls:SearchOptionGlyph}">
      <Setter Property="Foreground" Value="{StaticResource CaseSensitiveGlyphBrush}" />
    </Style>

    <Style x:Key="RegularExpressionOptionGlyphStyle"
           BasedOn="{StaticResource SearchOptionGlyphStyle}"
           TargetType="{x:Type controls:SearchOptionGlyph}">
      <Setter Property="Foreground" Value="{StaticResource RegularExpressionGlyphBrush}" />
    </Style>

    <Style x:Key="WholeWordOptionGlyphStyle"
           BasedOn="{StaticResource SearchOptionGlyphStyle}"
           TargetType="{x:Type controls:SearchOptionGlyph}">
      <Setter Property="Foreground" Value="{StaticResource WholeWordGlyphBrush}" />
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Command="{Binding CancelCommand}" Key="Escape" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="16,16,16,8">
      <Grid.LayoutTransform>
        <ScaleTransform ScaleX="{Binding Zoom.Scale}" ScaleY="{Binding Zoom.Scale}" />
      </Grid.LayoutTransform>

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid>
          <TextBox x:Name="SearchTextBox"
                   AutomationProperties.HelpText="Type a pull request ID, bug ID, or words from an earlier Copilot conversation"
                   AutomationProperties.Name="Search conversation history"
                   Padding="8,4"
                   ToolTip="Search conversation history (Ctrl+F)"
                   IsEnabled="{Binding AreSearchInputsEnabled}"
                   MinHeight="30"
                   PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                   TabIndex="0"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Foreground="{Binding Foreground, ElementName=SearchTextBox}"
                     IsHitTestVisible="False"
                     Margin="9,0,9,0"
                     Opacity="0.55"
                     Text="{Binding SearchWatermarkText}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SearchText}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <Grid Grid.Column="1" Margin="8,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button AutomationProperties.Name="Search"
                  Command="{Binding SearchCommand}"
                  IsDefault="True"
                  MinHeight="30"
                  MinWidth="80"
                  Padding="10,4,6,4"
                  TabIndex="1"
                  ToolTip="Search (Enter or Alt+S)">
            <StackPanel Style="{StaticResource IconTextButtonContentStyle}"
                        Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons"
                         FontSize="14"
                         IsHitTestVisible="False"
                         Text="&#xE721;"
                         VerticalAlignment="Center" />
              <AccessText Margin="5,0,0,0"
                          Text="_Search"
                          VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="SearchOptionsButton"
                  Grid.Column="1"
                  Panel.ZIndex="1"
                  AutomationProperties.HelpText="Choose literal, regular-expression, or AI-assisted matching"
                  AutomationProperties.Name="Search options"
                  Click="SearchOptionsButton_Click"
                  IsEnabled="{Binding AreSearchInputsEnabled}"
                  Margin="-1,0,0,0"
                  MinHeight="30"
                  MinWidth="24"
                  Padding="2"
                  TabIndex="2"
                  ToolTip="Search options (Alt+O)"
                  VerticalAlignment="Stretch">
            <Button.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Match _whole word"
                          IsCheckable="True"
                          IsChecked="{Binding MatchWholeWord, Mode=TwoWay}"
                          IsEnabled="{Binding AreLiteralSearchOptionsEnabled}"
                          StaysOpenOnClick="True"
                          ToolTip="Letters, digits, and underscore count as word characters">
                  <MenuItem.Icon>
                    <controls:SearchOptionGlyph Kind="WholeWord"
                                                Style="{StaticResource WholeWordOptionGlyphStyle}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Case sensitive"
                          IsCheckable="True"
                          IsChecked="{Binding IsCaseSensitive, Mode=TwoWay}"
                          IsEnabled="{Binding AreLiteralSearchOptionsEnabled}"
                          StaysOpenOnClick="True"
                          ToolTip="Match uppercase and lowercase exactly">
                  <MenuItem.Icon>
                    <controls:SearchOptionGlyph Kind="CaseSensitive"
                                                Style="{StaticResource CaseSensitiveOptionGlyphStyle}" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Use _regular expression"
                          IsCheckable="True"
                          IsChecked="{Binding UseRegularExpression, Mode=TwoWay}"
                          IsEnabled="{Binding AreLiteralSearchOptionsEnabled}"
                          StaysOpenOnClick="True"
                          ToolTip="Interpret the search text as a .NET regular expression; leave Case sensitive unchecked to ignore casing">
                  <MenuItem.Icon>
                    <controls:SearchOptionGlyph Kind="RegularExpression"
                                                Style="{StaticResource RegularExpressionOptionGlyphStyle}" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Use _AI search"
                          IsCheckable="True"
                          IsChecked="{Binding UseAiSearch, Mode=TwoWay}"
                          StaysOpenOnClick="True"
                          ToolTip="Send the query and a bounded set of locally prefiltered excerpts to Copilot for relevance ranking">
                  <MenuItem.Icon>
                    <controls:SearchOptionGlyph Kind="AiSearch"
                                                Style="{StaticResource AiSearchOptionGlyphStyle}" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </Button.ContextMenu>
            <TextBlock FontFamily="Segoe Fluent Icons"
                       FontSize="12"
                       IsHitTestVisible="False"
                       Text="&#xE70D;" />
          </Button>
        </Grid>
        <Button Grid.Column="2"
                Command="{Binding CancelCommand}"
                IsEnabled="{Binding IsBackgroundWorkActive}"
                Margin="8,0,0,0"
                MinWidth="88"
                TabIndex="3"
                ToolTip="Cancel search (Escape or Alt+C)">
          <StackPanel Style="{StaticResource IconTextButtonContentStyle}"
                      Orientation="Horizontal">
            <Rectangle Height="9"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Width="9">
              <Rectangle.Style>
                <Style TargetType="{x:Type Rectangle}">
                  <Setter Property="Fill" Value="{StaticResource StopGlyphBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                 Value="False">
                      <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Rectangle.Style>
            </Rectangle>
            <AccessText Margin="5,0,0,0"
                        Text="_Cancel"
                        VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <TextBlock Grid.Row="1"
                 AutomationProperties.LiveSetting="Assertive"
                 FontWeight="SemiBold"
                 Margin="0,10,0,0"
                 Text="{Binding ErrorMessage}">
        <TextBlock.Style>
          <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <ListView x:Name="SearchResultsListView"
                Grid.Row="2"
                AutomationProperties.Name="Matching Copilot sessions"
                ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                ItemTemplate="{StaticResource SearchResultTemplate}"
                ItemsSource="{Binding Results}"
                KeyboardNavigation.TabNavigation="Once"
                Margin="0,12,0,0"
                PreviewKeyDown="SearchResultsListView_PreviewKeyDown"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedResult}"
                SelectionMode="Single"
                TabIndex="4"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling" />

    </Grid>

    <StatusBar Grid.Row="1"
               Height="24"
               Padding="0">
      <StatusBarItem HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     Padding="8,0"
                     VerticalContentAlignment="Center">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock AutomationProperties.LiveSetting="Polite"
                     FontSize="12"
                     Text="{Binding StatusText}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />

          <ProgressBar Grid.Column="1"
                       AutomationProperties.Name="Search and index progress"
                       Height="3"
                       IsIndeterminate="{Binding IsProgressIndeterminate}"
                       Margin="12,0,0,0"
                       Maximum="{Binding TotalSessionCount}"
                       Value="{Binding CompletedSessionCount}"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsBackgroundWorkActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Width="96" />

          <TextBlock Grid.Column="2"
                     AutomationProperties.LiveSetting="Polite"
                     FontSize="12"
                     Margin="12,0,0,0"
                     Text="{Binding MatchSummaryText}"
                     VerticalAlignment="Center" />

          <controls:ZoomStatusControl Grid.Column="3"
                                      DataContext="{Binding Zoom}"
                                      Margin="8,0,0,0"
                                      TabIndex="5" />

          <Button x:Name="ThemeMenuButton"
                  Grid.Column="4"
                  AutomationProperties.HelpText="Switch between System, Light, and Dark themes"
                  AutomationProperties.Name="{Binding ThemeMenuText}"
                  Click="ThemeMenuButton_Click"
                  Margin="8,0,0,0"
                  MinHeight="24"
                  MinWidth="26"
                  Padding="4,1"
                  TabIndex="6"
                  ToolTip="{Binding ThemeMenuText}">
            <Button.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Command="{Binding SelectThemeCommand}"
                          CommandParameter="{Binding SystemThemeOption}"
                          Header="_System"
                          IsCheckable="True"
                          IsChecked="{Binding IsSystemTheme, Mode=OneWay}">
                  <MenuItem.Icon>
                    <controls:ThemeGlyph Height="14"
                                         Preference="System"
                                         Width="14" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding SelectThemeCommand}"
                          CommandParameter="{Binding LightThemeOption}"
                          Header="_Light"
                          IsCheckable="True"
                          IsChecked="{Binding IsLightTheme, Mode=OneWay}">
                  <MenuItem.Icon>
                    <controls:ThemeGlyph Height="14"
                                         Preference="Light"
                                         Width="14" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding SelectThemeCommand}"
                          CommandParameter="{Binding DarkThemeOption}"
                          Header="_Dark"
                          IsCheckable="True"
                          IsChecked="{Binding IsDarkTheme, Mode=OneWay}">
                  <MenuItem.Icon>
                    <controls:ThemeGlyph Height="14"
                                         Preference="Dark"
                                         Width="14" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </Button.ContextMenu>
            <controls:ThemeGlyph Height="14"
                                 IsHitTestVisible="False"
                                 Preference="{Binding SelectedThemeOption.Preference}"
                                 Width="14" />
          </Button>
        </Grid>
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
