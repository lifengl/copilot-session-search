<Window x:Class="CopilotSessionSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CopilotSessionSearch.Controls"
        Height="720"
        MinHeight="480"
        MinWidth="720"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Title="Copilot Session Search"
        Width="1040"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="SampleTemplate">
      <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
              BorderThickness="1"
              Margin="0,6,0,0"
              Padding="8">
        <StackPanel>
          <TextBlock FontWeight="SemiBold">
            <Run Text="{Binding SpeakerText, Mode=OneTime}" />
            <Run Text=" - " />
            <Run Text="{Binding TimestampText, Mode=OneTime}" />
          </TextBlock>
          <controls:HighlightedTextBlock HighlightText="{Binding Query, Mode=OneTime}"
                                         Margin="0,3,0,0"
                                         MaxHeight="44"
                                         SourceText="{Binding PreviewText, Mode=OneTime}"
                                         TextTrimming="CharacterEllipsis"
                                         TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="SearchResultTemplate">
      <Border Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock FontSize="15"
                     FontWeight="SemiBold"
                     Text="{Binding Name, Mode=OneTime}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Name, Mode=OneTime}" />
          <TextBlock Grid.Column="1"
                     Margin="12,0,0,0"
                     Text="{Binding MatchCountText, Mode=OneTime}" />
          <TextBlock Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Margin="0,3,0,0"
                     Text="{Binding LastActiveText, Mode=OneTime}" />
          <TextBlock Grid.Row="2"
                     Grid.ColumnSpan="2"
                     Margin="0,3,0,0"
                     Text="{Binding WorkingDirectory, Mode=OneTime}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding WorkingDirectory, Mode=OneTime}" />
          <ItemsControl Grid.Row="3"
                        Grid.ColumnSpan="2"
                        ItemTemplate="{StaticResource SampleTemplate}"
                        ItemsSource="{Binding Samples, Mode=OneTime}" />
        </Grid>
      </Border>
    </DataTemplate>

    <Style x:Key="SearchResultItemStyle" TargetType="{x:Type ListViewItem}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneTime}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="0" />
      <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SearchResultItem_PreviewMouseLeftButtonUp" />
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Command="{Binding CancelCommand}" Key="Escape" />
  </Window.InputBindings>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="SearchTextBox"
               AutomationProperties.Name="Search conversation history"
               MinHeight="30"
               Padding="8,4"
               PreviewKeyDown="SearchTextBox_PreviewKeyDown"
               TabIndex="0"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Search conversation history (Ctrl+F)" />
      <Button Grid.Column="1"
              Command="{Binding SearchCommand}"
              Content="_Search"
              IsDefault="True"
              Margin="8,0,0,0"
              MinWidth="88"
              TabIndex="1"
              ToolTip="Search (Enter or Alt+S)" />
      <Button Grid.Column="2"
              Command="{Binding CancelCommand}"
              Content="_Cancel"
              Margin="8,0,0,0"
              MinWidth="88"
              TabIndex="2"
              ToolTip="Cancel search (Escape or Alt+C)" />
      <Label x:Name="ThemeLabel"
             Grid.Column="3"
             Content="_Theme:"
             Margin="16,0,4,0"
             Target="{Binding ElementName=ThemeComboBox}"
             VerticalContentAlignment="Center" />
      <ComboBox x:Name="ThemeComboBox"
                Grid.Column="4"
                AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding ThemeOptions, Mode=OneTime}"
                MinWidth="104"
                SelectedItem="{Binding SelectedThemeOption}"
                TabIndex="3"
                ToolTip="Follow Windows or force a light or dark theme" />
    </Grid>

    <TextBlock Grid.Row="1"
               AutomationProperties.LiveSetting="Assertive"
               Margin="0,10,0,0"
               Text="{Binding StatusText}" />

    <TextBlock Grid.Row="2"
               AutomationProperties.LiveSetting="Assertive"
               FontWeight="SemiBold"
               Margin="0,6,0,0"
               Text="{Binding ErrorMessage}">
      <TextBlock.Style>
        <Style TargetType="{x:Type TextBlock}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <ListView x:Name="SearchResultsListView"
              Grid.Row="3"
              AutomationProperties.Name="Matching Copilot sessions"
              ItemContainerStyle="{StaticResource SearchResultItemStyle}"
              ItemTemplate="{StaticResource SearchResultTemplate}"
              ItemsSource="{Binding Results}"
              KeyboardNavigation.TabNavigation="Once"
              Margin="0,12,0,0"
              PreviewKeyDown="SearchResultsListView_PreviewKeyDown"
              ScrollViewer.CanContentScroll="True"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              SelectedItem="{Binding SelectedResult}"
              SelectionMode="Single"
              TabIndex="4"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling" />
  </Grid>
</Window>
